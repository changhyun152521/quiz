{
  "name": "server",
  "version": "1.0.0",
  "description": "Node.js Express MongoDB Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon",
    "dev:debug": "nodemon --inspect",
    "check:syntax": "find . -path './node_modules' -prune -o -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:smoke": "node -e \"require('./config/loadEnv'); if (!process.env.JWT_SECRET) throw new Error('JWT_SECRET is required'); require('./config/security').validateJwtSecret(); console.log('server config smoke passed')\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
